# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection string. On Vercel, adding Neon from Storage sets DATABASE_URL automatically
# (either name works). Locally: postgres://<user>@localhost:5432/heartlebanon_dev
DATABASE_URI=

# Long random string used to sign admin sessions: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public site URL (used for metadata). e.g. https://heartoflebanon.org
NEXT_PUBLIC_SITE_URL=

# Vercel Blob token for image uploads (added automatically when you create a Blob store on Vercel).
# Leave empty locally: uploads are then stored in ./media.
BLOB_READ_WRITE_TOKEN=

# Optional, local development only: admin account created by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
